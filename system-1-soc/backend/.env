# Copy to .env and fill in real values. Never commit the real .env file.

ENVIRONMENT=development
DEBUG=true

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=honeyshield
POSTGRES_USER=honeyshield
POSTGRES_PASSWORD=changeme

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# --- OpenSearch ---
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=changeme
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false

# --- Auth ---
JWT_SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
HONEYSHIELD_API_KEY=replace-with-a-shared-device-secret

# --- Detection thresholds ---
LOGIN_ATTEMPT_THRESHOLD=5
LOGIN_ATTEMPT_WINDOW_SECONDS=60
PORT_SCAN_THRESHOLD=10
PORT_SCAN_WINDOW_SECONDS=30

# --- AI ---
ANOMALY_SCORE_THRESHOLD=0.05

# --- Threat intel (all optional — enrichment degrades gracefully without them) ---
GEOIP_DB_PATH=/opt/honeyshield/data/GeoLite2-City.mmdb
ABUSEIPDB_API_KEY=
TOR_EXIT_LIST_PATH=/opt/honeyshield/data/tor_exit_nodes.txt

# --- Alerting (all optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=honeyshield@example.com
ALERT_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Automated Response / Playbooks (Feature 100) ---
# Leave AUTOMATED_RESPONSE_ENABLED=false until you've validated detection
# accuracy against real traffic (see backend/TESTING.md) — with it false,
# every playbook still runs and every action is logged as "skipped", so
# you can review what WOULD have been blocked before ever turning this on.
AUTOMATED_RESPONSE_ENABLED=false
FIREWALL_BACKEND=mock
PFSENSE_HOST=https://192.168.1.1
PFSENSE_API_KEY=
PFSENSE_BLOCKLIST_ALIAS=honeyshield_blacklist
PFSENSE_SSH_HOST=192.168.1.1
PFSENSE_SSH_USER=admin
PFSENSE_SSH_KEY_PATH=
PFSENSE_SSH_PASSWORD=
PFSENSE_PF_TABLE=honeyshield_blacklist
AUTO_BLOCK_REVIEW_AFTER_HOURS=72

# --- Reporting ---
REPORTS_DIR=/opt/honeyshield/reports

# --- System health ---
DISK_USAGE_WARNING_PERCENT=80
DISK_USAGE_CRITICAL_PERCENT=90

# --- CORS ---
CORS_ORIGINS=http://localhost:5173


